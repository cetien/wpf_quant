<UserControl x:Class="Quant.UI.Controls.RatingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="20">

    <!-- 0~10 rating 선택 공용 컨트롤
         - 별 10개 표시 (★ 채워진 별 / ☆ 빈 별)
         - Rating 값 = 노란 별 개수 (0이면 전부 검정)
         - 클릭한 위치의 인덱스+1 이 새 Rating
         - Tag=0 인 별을 클릭하면 Rating = 0 (초기화)
    -->

    <ItemsControl x:Name="StarPanel"
                  ItemsSource="{Binding Stars, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- Star 하나 = TextBlock, Tag에 1-based 인덱스 보관 -->
                <TextBlock Text="{Binding Glyph}"
                           FontSize="14"
                           FontFamily="Segoe UI Emoji"
                           Foreground="{Binding FillBrush}"
                           Cursor="Hand"
                           Margin="1,0"
                           VerticalAlignment="Center"
                           Tag="{Binding Index}"
                           MouseLeftButtonUp="Star_Click"
                           ToolTip="{Binding Index}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>