<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<!-- ────────────────
⬇⏬⤓📥💾⬇️↻↺⇄📈
🔄🔁♻️🔖📑⭐👁️‍🗨️👁✦🗄️📦
-->

        <SolidColorBrush x:Key="BgBase"      Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BgPanel"     Color="#181825"/>
        <SolidColorBrush x:Key="BgTextBox"   Color="#252536"/>
        <SolidColorBrush x:Key="BgSurface"   Color="#313244"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#89B4FA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#7E8192"/>
        <SolidColorBrush x:Key="TextError"   Color="#F38BA8"/>
        <SolidColorBrush x:Key="BorderColor" Color="#45475A"/>
        <SolidColorBrush x:Key="GridLineColor" Color="#252536"/>

        <!-- common -->
        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    
        <Style x:Key="BoldText" TargetType="TextBlock" BasedOn="{StaticResource NormalText}">
            <Setter Property="FontWeight"   Value="SemiBold"/>
        </Style>
    
        <Style x:Key="SmallText" TargetType="TextBlock" BasedOn="{StaticResource NormalText}">
            <Setter Property="FontSize"     Value="9"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgTextBox}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="2,2"/>
            <Setter Property="Margin"          Value="0,2,0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Panel section header -->
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource BgTextBox}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"  Value="0,0,0,1"/>
            <Setter Property="Padding"          Value="8,0"/>
            <Setter Property="Height"           Value="28"/>
        </Style>



<!-- ────────────────
        <Style x:Key="GroupCheckBox" TargetType="CheckBox">
-->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="Margin"      Value="0,3,4,1"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>


</ResourceDictionary>
