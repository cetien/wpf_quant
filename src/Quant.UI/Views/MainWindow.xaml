<Window x:Class="Quant.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Quant.UI.Controls"
        Title="Quant" Height="1000" Width="1540"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>

        <Style x:Key="ToolBarButton" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="#6C7086"/>
            <Setter Property="BorderBrush"       Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0,0,0,2"/>
            <Setter Property="Width"             Value="68"/>
            <Setter Property="Height"            Value="48"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Padding"           Value="0"/>
            <Setter Property="FontFamily"        Value="Segoe UI Emoji"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252536"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#313244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ── 메뉴바 ──────────────────────────────── -->
        <Menu Grid.Row="0" Background="#181825" Foreground="#CDD6F4" FontSize="12">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background" Value="#181825"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                    <Setter Property="FontSize"   Value="12"/>
                    <Setter Property="Padding"    Value="10,4"/>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#45475A"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="Options…" Click="MenuOptions_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Macro Indicator" IsEnabled="False" Foreground="#45475A"/>
                <MenuItem Header="Report"          Click="MenuReport_Click"/>
                <Separator/>
                <MenuItem Header="Side Panel" IsCheckable="True" IsChecked="True"
                          Click="MenuSidePanel_Click"/>
            </MenuItem>
            <MenuItem Header="_Tool">
                <MenuItem Header="Edit Group"     Click="MenuEditGroup_Click"/>
                <MenuItem Header="Edit Watchlist" Click="MenuEditWatchlist_Click"/>
            </MenuItem>
            <MenuItem Header="_Data">
                <MenuItem Header="Rebuild StockCache" Click="MenuRebuildStockCache_Click"/>
                <Separator/>
                <MenuItem Header="DB Browser" Click="MenuDbBrowser_Click"/>
            </MenuItem>
        </Menu>

        <!-- ── 툴바 ────────────────────────────────── -->
        <Border Grid.Row="1" Background="#181825" BorderBrush="#45475A" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Padding="16,0"
                        BorderBrush="#45475A" BorderThickness="0,0,1,0">
                    <Button Click="MenuSidePanel_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0" Style="{StaticResource ToolBarButton}"
                            Cursor="Hand">
                        <TextBlock Text="⬡ QUANT" FontSize="14" FontWeight="Bold"
                                   Foreground="#89B4FA" VerticalAlignment="Center"
                                   FontFamily="Consolas"/>
                    </Button>
                </Border>
                <TextBlock DockPanel.Dock="Right" x:Name="TxtDbPath" Margin="0,0,14,0"
                           FontSize="9" FontFamily="Consolas"
                           Foreground="#3D3F55" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus" DockPanel.Dock="Right"
                           FontSize="11" FontFamily="Consolas" Foreground="#6C7086"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Margin="20,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button x:Name="BtnDashboard" Style="{StaticResource ToolBarButton}"
                            Click="BtnDashboard_Click" ToolTip="Dashboard">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⊞" FontSize="15" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Segoe UI Symbol"/>
                            <TextBlock Text="Dashboard" FontSize="8" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnChart" Style="{StaticResource ToolBarButton}"
                            Click="BtnChart_Click" ToolTip="Chart">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x1F4C8;" FontSize="15" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="Chart" FontSize="8" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSearch" Style="{StaticResource ToolBarButton}"
                            Click="BtnSearch_Click" ToolTip="Search">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x1F50D;" FontSize="15" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="Search" FontSize="8" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Fill="#45475A" Width="1" Margin="4,10"/>
                    <Button x:Name="BtnDbBrowser" Style="{StaticResource ToolBarButton}"
                            Click="BtnDbBrowser_Click" ToolTip="DB Browser">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x1F5C4;" FontSize="15" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="DB" FontSize="8" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Fill="#45475A" Width="1" Margin="4,10"/>
                    <Button x:Name="BtnGroup" Style="{StaticResource ToolBarButton}"
                            Click="BtnGroup_Click" ToolTip="Group Editor">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x1F5C2;" FontSize="15" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="Group" FontSize="8" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnReport" Style="{StaticResource ToolBarButton}"
                            Click="BtnReport_Click" ToolTip="Report">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x1F4CB;" FontSize="15" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Segoe UI Emoji"/>
                            <TextBlock Text="Report" FontSize="8" HorizontalAlignment="Center"
                                       Foreground="#6C7086" FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── 본문: LeftSidePanel + 메인 컨텐츠 ──── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- 사이드패널 (토글 가능) -->
                <ColumnDefinition x:Name="SideColumn" Width="282"/>
                <!-- 구분선 -->
                <ColumnDefinition Width="1"/>
                <!-- 메인 콘텐츠 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 사이드패널 -->
            <ctrl:LeftSidePanel x:Name="SidePanel"
                                Grid.Column="0"
                                StockSelected="SidePanel_StockSelected"
                                GroupSelected="SidePanel_GroupSelected"
                                IndicatorSelected="SidePanel_IndicatorSelected"/>

            <!-- 수직 구분선 -->
            <Rectangle Grid.Column="1" Fill="#FF74769C"/>

            <!-- 메인 컨텐츠 영역 -->
            <ContentPresenter Grid.Column="2" x:Name="MainContent"/>
        </Grid>

        <!-- ── 상태바 ────────────────────────────────── -->
        <Border Grid.Row="3" Background="#181825" BorderBrush="#45475A" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusMsg" Grid.Column="0" Text="준비"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#6C7086" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtElapsed" Grid.Column="1"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#45475A" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
