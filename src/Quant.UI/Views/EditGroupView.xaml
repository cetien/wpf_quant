<UserControl x:Class="Quant.UI.Views.EditGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#1E1E2E">
    <UserControl.Resources>

        <!-- DataGrid -->
        <Style x:Key="QuantDataGrid" TargetType="DataGrid">
            <Setter Property="Background"               Value="#181825"/>
            <Setter Property="Foreground"               Value="#CDD6F4"/>
            <Setter Property="BorderBrush"              Value="#45475A"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="RowBackground"            Value="#181825"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1E2E"/>
            <Setter Property="ColumnHeaderHeight"       Value="28"/>
            <Setter Property="RowHeight"                Value="24"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="FontFamily"               Value="Consolas"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="AutoGenerateColumns"      Value="True"/>
            <Setter Property="CanUserSortColumns"       Value="True"/>
            <Setter Property="CanUserResizeColumns"     Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#252536"/>
            <Setter Property="Foreground"      Value="#89B4FA"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Padding"         Value="6,0"/>
            <Setter Property="BorderBrush"     Value="#45475A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="Foreground"      Value="#CDD6F4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="#313244"/>
            <Setter Property="Foreground"      Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#585b70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1E1E2E"/>
                                <Setter Property="Foreground" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Period button -->
        <Style x:Key="PeriodBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#6C7086"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel section header -->
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background"       Value="#252536"/>
            <Setter Property="BorderBrush"      Value="#45475A"/>
            <Setter Property="BorderThickness"  Value="0,0,0,1"/>
            <Setter Property="Padding"          Value="8,0"/>
            <Setter Property="Height"           Value="28"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="Foreground"   Value="#6C7086"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════
         외부 레이아웃: 툴바 / 본문 / 상태바
    ═══════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- 툴바 -->
            <RowDefinition Height="*"/>    <!-- 본문 2×2 -->
            <RowDefinition Height="22"/>   <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- ── 툴바 ─────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏷 GROUP EDITOR" Style="{StaticResource SectionLabel}"
                               Foreground="#6C7086" Margin="0,0,16,0"/>
                    <Button Content="＋ New"    Style="{StaticResource ActionBtn}" Click="BtnNew_Click"/>
                    <Button Content="✎ Edit"   Style="{StaticResource ActionBtn}" Click="BtnEdit_Click"/>
                    <Button x:Name="BtnDel" Content="✕ Delete" Style="{StaticResource ActionBtn}"
                            Click="BtnDelete_Click" Foreground="#F38BA8"/>
                </StackPanel>
                <TextBlock x:Name="TxtRowCount" HorizontalAlignment="Right"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#6C7086" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── 본문: 좌/우 분할 ──────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>   <!-- 좌: 그룹·티커 -->
                <ColumnDefinition Width="4"/>                  <!-- splitter -->
                <ColumnDefinition Width="*" MinWidth="300"/>   <!-- 우: 기능·차트 -->
            </Grid.ColumnDefinitions>

            <!-- ── 좌측: 상하 분할 ────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80"/>   <!-- 좌상: 그룹 Grid -->
                    <RowDefinition Height="4"/>                   <!-- splitter -->
                    <RowDefinition Height="*" MinHeight="80"/>   <!-- 좌하: 티커 Grid -->
                </Grid.RowDefinitions>

                <!-- 좌상: 그룹 Grid -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <TextBlock Text="GROUPS" Style="{StaticResource SectionLabel}"/>
                    </Border>
                    <DataGrid x:Name="GridGroup" Grid.Row="1"
                              Style="{StaticResource QuantDataGrid}"
                              AutoGenerateColumns="False"
                              SelectionChanged="GridGroup_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="kind"   Binding="{Binding kind}"   Width="90"/>
                            <DataGridTextColumn Header="name"   Binding="{Binding name}"   Width="90"/>
                            <DataGridTextColumn Header="description"   Binding="{Binding description}"   Width="90"/>
                            <DataGridTextColumn Header="rating"   Binding="{Binding rating}"   Width="90"/>
                            <DataGridTextColumn Header="count"   Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"
                              Background="#45475A" ResizeBehavior="PreviousAndNext"/>

                <!-- 좌하: 티커 Grid -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <Grid>
                            <TextBlock x:Name="TxtTickerHeader" Text="TICKERS"
                                       Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="BtnDownloadGroup" Content="🔄" Style="{StaticResource ActionBtn}"
                                        Padding="6,3" Margin="0,0,3,0" Click="BtnDownloadGroup_Click"
                                        ToolTip="그룹 전체 가격 데이터 다운로드"/>
                                <Button x:Name="BtnAddTicker"    Content="＋" Style="{StaticResource ActionBtn}"
                                        Padding="6,3" Margin="0,0,3,0" Click="BtnAddTicker_Click"/>
                                <Button x:Name="BtnRemoveTicker" Content="✕" Style="{StaticResource ActionBtn}"
                                        Padding="6,3" Margin="0" Foreground="#F38BA8"
                                        Click="BtnRemoveTicker_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="GridTicker" Grid.Row="1"
                              Style="{StaticResource QuantDataGrid}"
                              AutoGenerateColumns="False"
                              SelectionChanged="GridTicker_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="chart"   Width="30"/>
                            <DataGridTextColumn Header="ticker"   Binding="{Binding ticker}"   Width="90"/>
                            <DataGridTextColumn Header="name"   Binding="{Binding name}"   Width="90"/>
                            <DataGridTextColumn Header="market"   Binding="{Binding market}"   Width="90"/>
                            <DataGridTextColumn Header="weight"   Binding="{Binding weight}"   Width="90"/>
                            <DataGridTextColumn Header="rating"   Width="90"/>
                            <DataGridTemplateColumn Header="" Width="36" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" FontSize="13"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="삭제"
                                        Foreground="#F38BA8"
                                        HorizontalAlignment="Center"
                                        Tag="{Binding}"
                                        Click="BtnDeleteTicker_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch"
                          Background="#45475A" ResizeBehavior="PreviousAndNext"/>

            <!-- ── 우측: 기능 패널 + 차트 ────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 우상: 기능 패널 -->
                    <RowDefinition Height="*"/>      <!-- 우하: 차트 -->
                </Grid.RowDefinitions>

                <!-- 우상: 기능 패널 (버튼 배치 예정) -->
                <Border Grid.Row="0" Background="#252536"
                        BorderBrush="#45475A" BorderThickness="0,0,0,1">
                    <StackPanel Margin="8,6">
                        <!-- 그룹 정보 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Group:" Style="{StaticResource SectionLabel}"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtGroupName" FontSize="11" FontFamily="Consolas"
                                       Foreground="#CDD6F4" VerticalAlignment="Center"/>
                            <Button x:Name="BtnChartAll"  Content="All"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnChart_Click" Tag="0"/>
                            <Button x:Name="BtnChartOne"  Content="One"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnChart_Click" Tag="1"/>
                        </StackPanel>
                        <!-- 기간 버튼 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Period:" Style="{StaticResource SectionLabel}"
                                       Margin="0,0,8,0"/>
                            <Button x:Name="Btn1M"  Content="1M"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="30"/>
                            <Button x:Name="Btn3M"  Content="3M"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="90"/>
                            <Button x:Name="Btn6M"  Content="6M"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="180"/>
                            <Button x:Name="Btn1Y"  Content="1Y"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="365"/>
                            <Button x:Name="Btn2Y"  Content="2Y"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="730"/>
                            <Button x:Name="BtnAll" Content="ALL" Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="0"/>
                            <TextBlock x:Name="TxtChartInfo" FontSize="10" FontFamily="Consolas"
                                       Foreground="#6C7086" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <!-- 추가 기능 버튼 자리 (이 아래에 배치 예정) -->
                    </StackPanel>
                </Border>

                <!-- 우하: 차트 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <TextBlock Text="📈 RELATIVE PERFORMANCE  (Base 100)"
                                   Style="{StaticResource SectionLabel}"/>
                    </Border>
                    <lvc:CartesianChart x:Name="Chart" Grid.Row="1"
                                        Background="#1E1E2E"
                                        Series="{Binding ChartSeries}"
                                        XAxes="{Binding ChartXAxes}"
                                        YAxes="{Binding ChartYAxes}"
                                        ZoomMode="X"
                                        TooltipPosition="Top"/>
                </Grid>

            </Grid>
        </Grid>

        <!-- ── 상태바 ─────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#252536" Padding="10,0">
            <TextBlock x:Name="TxtStatus" Text=""
                       FontSize="10" FontFamily="Consolas"
                       Foreground="#6C7086" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
