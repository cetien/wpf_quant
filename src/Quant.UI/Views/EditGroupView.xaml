<UserControl x:Class="Quant.UI.Views.EditGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Quant.UI.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#1E1E2E">
<!-- ═══════════════════════════════════════════════════════
         외부 레이아웃: 툴바 / 본문 / 상태바
    ═══════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- 툴바 -->
            <RowDefinition Height="*"/>    <!-- 본문 2×2 -->
            <RowDefinition Height="22"/>   <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- ── 툴바 ─────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏷 GROUP EDITOR" Style="{StaticResource SectionLabel}"
                               Foreground="#6C7086" Margin="0,0,16,0"/>
                    <Button Content="＋ New"    Style="{StaticResource ActionBtn}" Click="BtnNewGroup_Click"/>
                    <Button Content="✎ Edit"   Style="{StaticResource ActionBtn}" Click="BtnEditGroup_Click"/>
                    <Button x:Name="BtnDel" Content="✕ Delete" Style="{StaticResource ActionBtn}"
                            Click="BtnDeleteGroup_Click" Foreground="#F38BA8"/>
                </StackPanel>
                <TextBlock x:Name="TxtRowCount" HorizontalAlignment="Right"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#6C7086" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── 본문: 좌/우 분할 ──────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>   <!-- 좌: 그룹·티커 -->
                <ColumnDefinition Width="4"/>                  <!-- splitter -->
                <ColumnDefinition Width="*" MinWidth="300"/>   <!-- 우: 기능·차트 -->
            </Grid.ColumnDefinitions>

            <!-- ── 좌측: 상하 분할 ────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80"/>   <!-- 좌상: 그룹 Grid -->
                    <RowDefinition Height="4"/>                   <!-- splitter -->
                    <RowDefinition Height="*" MinHeight="80"/>   <!-- 좌하: 티커 Grid -->
                </Grid.RowDefinitions>

                <!-- 좌상: 그룹 Grid -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SectionHeader}" Cursor="">
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="#" x:Name="GroupGridCount" Style="{StaticResource SectionLabel}" Foreground="#FFEADC43"/>
                            <TextBlock Text="GROUPS" Style="{StaticResource SectionLabel}" Margin="6,0,6,0"/>
                            <CheckBox x:Name="chkAllGroup" Content="All" Click="GroupFilter_Click" Tag="All"/>
                            <CheckBox x:Name="chkSectorGroup" Content="Sector" Click="GroupFilter_Click" Tag="Sector"/>
                            <CheckBox x:Name="chkThemeGroup" Content="Theme" Click="GroupFilter_Click" Tag="Theme"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="GridGroup" Grid.Row="1"
                              Style="{StaticResource QuantDataGrid}"
                              AutoGenerateColumns="False"
                              SelectionChanged="GridGroup_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="kind"   Binding="{Binding kind}"   Width="90"/>
                            <DataGridTextColumn Header="name"   Binding="{Binding name}"   Width="100"/>
                            <DataGridTextColumn Header="description"   Binding="{Binding description}"   Width="130"/>
                            <DataGridTextColumn Header="rating"   Binding="{Binding rating}"   Width="60"/>
                            <DataGridTextColumn Header="count"   Binding="{Binding count}"   Width="50"/>
                            <DataGridTextColumn Header="active"   Binding="{Binding is_active}"   Width="46"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"
                              Background="#45475A" ResizeBehavior="PreviousAndNext"/>

                <!-- 좌하: 티커 Grid -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <Grid>
                            <TextBlock x:Name="TxtCurrGroupNameAtGrid" Text="Group"
                                       Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <ctrl:RatingControl x:Name="GroupRatingCtrl" Rating="5" Margin="0,2,10,3" Height="22"
                                                    RatingChanged="GroupRatingCtrl_RatingChanged"/>
                                <Button x:Name="BtnChartAll"  Content="All"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnChart_Click" Tag="1"/>
                                <Button x:Name="BtnChartClear"  Content="Clear"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnChart_Click" Tag="0"/>
                                <CheckBox x:Name="CheckboxAddTicker" Content="Add" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="BtnDownloadGroup" Content="🔄" Style="{StaticResource ActionBtn}"
                                        Padding="6,3" Margin="0,0,3,0" Click="BtnDownloadGroup_Click"
                                        ToolTip="그룹 전체 가격 데이터 다운로드"/>
                                <Button x:Name="BtnRemoveTicker" Content="✕" Style="{StaticResource ActionBtn}"
                                        Padding="6,3" Margin="0" Foreground="#F38BA8"
                                        Click="BtnRemoveTicker_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="GridTicker" Grid.Row="1"
                              Style="{StaticResource QuantDataGrid}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              SelectionChanged="GridTicker_SelectionChanged"
                              MouseDoubleClick="GridTicker_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="chart" Width="30" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding chart_selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="ChartSelected_Changed"
                                                  Unchecked="ChartSelected_Changed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="name"     Binding="{Binding name}"     Width="90"/>
                            <DataGridTextColumn Header="market"   Binding="{Binding market}"   Width="60"/>
                            <DataGridTextColumn Header="weight"   Binding="{Binding weight}"   Width="30"/>
                            <DataGridTextColumn Header="1M %" Binding="{Binding ret_1m, Converter={StaticResource FmtF2}, ConverterParameter=F2}" Width="60"/>
                            <DataGridTextColumn Header="3M %"     Binding="{Binding ret_3m, Converter={StaticResource FmtF2}, ConverterParameter=F2}"   Width="60"/>
                            <DataGridTextColumn Header="6M %"     Binding="{Binding ret_6m, Converter={StaticResource FmtF2}, ConverterParameter=F2}"   Width="60"/>
                            <DataGridTextColumn Header="1Y %"     Binding="{Binding ret_1y, Converter={StaticResource FmtF2}, ConverterParameter=F2}"   Width="60"/>
                            <DataGridTextColumn Header="rs"     Binding="{Binding rs, Converter={StaticResource FmtF1}, ConverterParameter=F1}"   Width="60"/>
                            <DataGridTextColumn Header="per"     Binding="{Binding per, Converter={StaticResource FmtN0}, ConverterParameter=N0}"   Width="60"/>
                            <DataGridTextColumn Header="pbr"     Binding="{Binding pbr, Converter={StaticResource FmtN0}, ConverterParameter=F2}"   Width="60"/>
                            <DataGridTextColumn Header="roe"     Binding="{Binding roe, Converter={StaticResource FmtN0}, ConverterParameter=F2}"   Width="60"/>
                            <DataGridTextColumn Header="%atr"     Binding="{Binding atr_percent, Converter={StaticResource FmtF1}, ConverterParameter=F1}"   Width="60"/>
                            <DataGridTextColumn Header="distance_from_high"     Binding="{Binding distance_from_high, Converter={StaticResource FmtF1}, ConverterParameter=F1}"   Width="60"/>
                            <DataGridTextColumn Header="volume_avg_20d"     Binding="{Binding volume_avg_20d, Converter={StaticResource FmtVol}, ConverterParameter=vol}"   Width="60"/>

                            <DataGridTemplateColumn Header="" Width="36" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" FontSize="13"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="삭제"
                                        Foreground="#F38BA8"
                                        HorizontalAlignment="Center"
                                        Tag="{Binding}"
                                        Click="BtnDeleteTicker_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch"
                          Background="#45475A" ResizeBehavior="PreviousAndNext"/>

            <!-- ── 우측: 기능 패널 + 차트 ────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 우상: 기능 패널 -->
                    <RowDefinition Height="*"/>      <!-- 우하: 차트 -->
                </Grid.RowDefinitions>

                <!-- 우상: 기능 패널 (버튼 배치 예정) -->
                <Border Grid.Row="0" Background="#252536"
                        BorderBrush="#45475A" BorderThickness="0,0,0,1">
                    <StackPanel Margin="8,6">
                        <!-- 그룹 정보 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="TxtGroupNameAtChart" Text="Group" FontSize="11" FontFamily="Consolas"
                                       Foreground="#CDD6F4" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 기간 버튼 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Period:" Style="{StaticResource SectionLabel}"
                                       Margin="0,0,8,0"/>
                            <Button x:Name="Btn1M"  Content="1M"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="30"/>
                            <Button x:Name="Btn3M"  Content="3M"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="90"/>
                            <Button x:Name="Btn6M"  Content="6M"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="180"/>
                            <Button x:Name="Btn1Y"  Content="1Y"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="365"/>
                            <Button x:Name="Btn2Y"  Content="2Y"  Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="730"/>
                            <Button x:Name="BtnAll" Content="ALL" Style="{StaticResource PeriodBtn}"
                                    Click="BtnPeriod_Click" Tag="0"/>
                            <TextBlock x:Name="TxtChartInfo" FontSize="10" FontFamily="Consolas"
                                       Foreground="#6C7086" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <!-- 추가 기능 버튼 자리 (이 아래에 배치 예정) -->
                    </StackPanel>
                </Border>

                <!-- 우하: 차트 -->
                <Grid x:Name="ChartAreaGrid" Grid.Row="1"
                      MouseMove="ChartAreaGrid_MouseMove"
                      MouseLeave="ChartAreaGrid_MouseLeave">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SectionHeader}">
                        <TextBlock Text="📈 RELATIVE PERFORMANCE  (Base 100)"
                                   Style="{StaticResource SectionLabel}"/>
                    </Border>
                    <lvc:CartesianChart x:Name="Chart" Grid.Row="1"
                                        Background="#1E1E2E"
                                        Series="{Binding ChartSeries}"
                                        XAxes="{Binding ChartXAxes}"
                                        YAxes="{Binding ChartYAxes}"
                                        ZoomMode="X"
                                        TooltipPosition="Hidden"/>

                    <!-- ── Crosshair 오버레이 (Row 1 = 차트 영역) ── -->
                    <Canvas x:Name="EgCrosshairCanvas"
                            Grid.Row="1"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <Line x:Name="EgCrossV"
                              Stroke="#4C566A" StrokeThickness="1"
                              StrokeDashArray="4,3"
                              X1="0" Y1="0" X2="0" Y2="0"/>
                        <Line x:Name="EgCrossH"
                              Stroke="#4C566A" StrokeThickness="1"
                              StrokeDashArray="4,3"
                              X1="0" Y1="0" X2="0" Y2="0"/>

                        <Border x:Name="EgTooltipPanel"
                                Canvas.Left="8" Canvas.Top="8"
                                Background="#CC1E1E2E"
                                BorderBrush="#45475A" BorderThickness="1"
                                CornerRadius="4" Padding="8,6"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="EgTtDate"
                                           FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                           Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                <StackPanel x:Name="EgTtRows"/>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>

            </Grid>
        </Grid>

        <!-- ── 상태바 ─────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#252536" Padding="10,0">
            <TextBlock x:Name="TxtStatus" Text=""
                       FontSize="10" FontFamily="Consolas"
                       Foreground="#6C7086" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>


