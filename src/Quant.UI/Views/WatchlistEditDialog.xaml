<Window x:Class="Quant.UI.Views.WatchlistEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="워치리스트 편집" Width="400" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="#CDD6F4">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6C7086"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Inp" TargetType="TextBox">
            <Setter Property="Background"      Value="#252536"/>
            <Setter Property="Foreground"      Value="#CDD6F4"/>
            <Setter Property="CaretBrush"      Value="#89B4FA"/>
            <Setter Property="BorderBrush"     Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="Margin"          Value="0,0,0,12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Name" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtName" Style="{StaticResource Inp}"/>
            <TextBlock Text="Description" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtDesc" Style="{StaticResource Inp}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="72" Height="32" Margin="0,0,8,0"
                    Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                    Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Content="저장" Width="72" Height="32"
                    Background="#89B4FA" Foreground="#1E1E2E" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
