<UserControl x:Class="Quant.UI.Views.DbBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" MinWidth="140"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 테이블 목록 -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#45475A" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#252536" Padding="12,0">
                    <TextBlock Text="TABLES" FontSize="10" FontWeight="Bold"
                               Foreground="#6C7086" VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TableList" Margin="4,4"/>
                </ScrollViewer>
                <ComboBox x:Name="CmbCommandType" Grid.Row="2" Background="#313244" SelectionChanged="CmbCommandType_SelectionChanged">
                    <ComboBoxItem Content="SELECT" IsSelected="True"/>
                    <ComboBoxItem Content="UPDATE"/>
                    <ComboBoxItem Content="INSERT"/>
                    <ComboBoxItem Content="DELETE"/>
                </ComboBox>
                <TextBox x:Name="TxtWhere" Grid.Row="3" Text="ticker='000000'"/>
                <ComboBox x:Name="CmbJoin" Grid.Row="4" Background="#313244" ToolTip="JOIN"
                          SelectionChanged="CmbSqlOption_SelectionChanged">
                    <ComboBoxItem Content="(JOIN 없음)"       Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="JOIN stock_cache"  Tag="JOIN stock_cache c ON s.ticker=c.ticker"/>
                    <ComboBoxItem Content="JOIN daily_prices" Tag="JOIN daily_prices p ON s.ticker=p.ticker"/>
                    <ComboBoxItem Content="JOIN fundamentals" Tag="JOIN fundamentals f ON s.ticker=f.ticker"/>
                    <ComboBoxItem Content="JOIN supply"       Tag="JOIN supply u ON s.ticker=u.ticker"/>
                </ComboBox>
                <ComboBox x:Name="CmbGroupBy" Grid.Row="5" Background="#313244" ToolTip="GROUP BY"
                          SelectionChanged="CmbSqlOption_SelectionChanged">
                    <ComboBoxItem Content="(GROUP BY 없음)" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="GROUP BY ticker" Tag="ticker"/>
                    <ComboBoxItem Content="GROUP BY rating" Tag="rating"/>
                    <ComboBoxItem Content="GROUP BY date"   Tag="date"/>
                    <ComboBoxItem Content="GROUP BY sector" Tag="sector"/>
                </ComboBox>
                <ComboBox x:Name="CmbOrderBy" Grid.Row="6" Background="#313244" ToolTip="ORDER BY"
                          SelectionChanged="CmbSqlOption_SelectionChanged">
                    <ComboBoxItem Content="(ORDER BY 없음)" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="date DESC"       Tag="date DESC"/>
                    <ComboBoxItem Content="date ASC"        Tag="date ASC"/>
                    <ComboBoxItem Content="ticker ASC"      Tag="ticker ASC"/>
                    <ComboBoxItem Content="name ASC"        Tag="name ASC"/>
                    <ComboBoxItem Content="rating DESC"     Tag="rating DESC"/>
                </ComboBox>
                <TextBox x:Name="TxtSqlSample" Grid.Row="7" Text="SELECT * FROM stocks LIMIT 500"/>
            </Grid>
        </Border>

        <!-- 구분선 -->
        <GridSplitter Grid.Column="1" Width="4" Background="#45475A"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- 오른쪽: 데이터 영역 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto" MinHeight="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- function button -->
            <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
                <Grid Margin="8,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCurrTicker" Text="ticker"
                               Foreground="#6C7086" Margin="0,0,16,0"/>
                        <Button Content="✕ cache"    Style="{StaticResource ActionBtn}" Tag="stock_cache" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ price"   Style="{StaticResource ActionBtn}" Tag="daily_prices" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ supply"   Style="{StaticResource ActionBtn}" Tag="supply" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ fundamentals"   Style="{StaticResource ActionBtn}" Tag="fundamentals" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ group"   Style="{StaticResource ActionBtn}" Tag="stock_group_map" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ stocks"   Style="{StaticResource ActionBtn}" Tag="stocks" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="update"   Style="{StaticResource ActionBtn}" Tag="UPDATE" Click="BtnCommand_Click" Foreground="#FF3A2027" Background="#FFA4ACD6"/>
                        <Button Content="insert"   Style="{StaticResource ActionBtn}" Tag="INSERT" Click="BtnCommand_Click" Foreground="#FF3A2027" Background="#FFA4ACD6"/>
                        <Button Content="delete"   Style="{StaticResource ActionBtn}" Tag="DELETE" Click="BtnCommand_Click" Foreground="#FF3A2027" Background="#FFA4ACD6"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTickerInfo" HorizontalAlignment="Right"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#6C7086" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- SQL 바 -->
            <Border Grid.Row="1" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
                <Grid Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSql" Grid.Column="0"
                             Text="SELECT * FROM stocks WHERE 1 LIMIT 500"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             MinHeight="36" MaxHeight="200"
                             VerticalAlignment="Stretch"
                             FontFamily="Consolas"
                             KeyDown="TxtSql_KeyDown"/>
                    <Button Grid.Column="1" Content="▶ 실행" Margin="6,0,0,0"
                            Background="#FF3A9448" Foreground="White"
                            FontWeight="Bold" Style="{StaticResource ActionBtn}"
                            VerticalAlignment="Top"
                            Click="BtnRun_Click"/>
                </Grid>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="MainGrid" Grid.Row="2"
                      Style="{StaticResource QuantDataGrid}"
                      Margin="0"/>

            <!-- 행 카운트 -->
            <Border Grid.Row="3" Background="#252536" Padding="10,0">
                <TextBlock x:Name="TxtRowCount" Text=""
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#6C7086" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
