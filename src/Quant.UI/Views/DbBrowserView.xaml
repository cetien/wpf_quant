<UserControl x:Class="Quant.UI.Views.DbBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <UserControl.Resources>

        <Style x:Key="SqlBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#252536"/>
            <Setter Property="Foreground"      Value="#CDD6F4"/>
            <Setter Property="CaretBrush"      Value="#89B4FA"/>
            <Setter Property="BorderBrush"     Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="8"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" MinWidth="140"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 테이블 목록 -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#45475A" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#252536" Padding="12,0">
                    <TextBlock Text="TABLES" FontSize="10" FontWeight="Bold"
                               Foreground="#6C7086" VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TableList" Margin="4,4"/>
                </ScrollViewer>
                <ComboBox x:Name="CmbCommandType" Grid.Row="2" Background="#313244" SelectionChanged="CmbCommandType_SelectionChanged">
                    <ComboBoxItem Content="SELECT" IsSelected="True"/>
                    <ComboBoxItem Content="UPDATE"/>
                    <ComboBoxItem Content="INSERT"/>
                    <ComboBoxItem Content="DELETE"/>
                </ComboBox>
                <TextBox x:Name="TxtWhere" Grid.Row="3" 
                             Background="#313244" Foreground="#CDD6F4"
                             BorderBrush="#45475A" BorderThickness="1"
                             FontFamily="Consolas" FontSize="12" Padding="4,2"
                             VerticalContentAlignment="Center" Text="ticker='000000'"/>
                <TextBox x:Name="TxtSqlSample" Grid.Row="4" Style="{StaticResource SqlBox}" Text="SELECT * FROM stocks LIMIT 500"/>
            </Grid>
        </Border>

        <!-- 구분선 -->
        <GridSplitter Grid.Column="1" Width="4" Background="#45475A"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- 오른쪽: 데이터 영역 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- function button -->
            <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
                <Grid Margin="8,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCurrTicker" Text="ticker" Style="{StaticResource SectionLabel}"
                               Foreground="#6C7086" Margin="0,0,16,0"/>
                        <Button Content="✕ cache"    Style="{StaticResource ActionBtn}" Tag="stock_cache" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ price"   Style="{StaticResource ActionBtn}" Tag="daily_prices" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ supply"   Style="{StaticResource ActionBtn}" Tag="supply" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ fundamentals"   Style="{StaticResource ActionBtn}" Tag="fundamentals" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ group"   Style="{StaticResource ActionBtn}" Tag="stock_group_map" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                        <Button Content="✕ stocks"   Style="{StaticResource ActionBtn}" Tag="stocks" Click="BtnFunction_Click" Foreground="#F38BA8"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTickerInfo" HorizontalAlignment="Right"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#6C7086" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- SQL 바 -->
            <Border Grid.Row="1" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
                <Grid Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSql" Grid.Column="0" Style="{StaticResource SqlBox}"
                             VerticalAlignment="Center" Height="32"
                             Text="SELECT * FROM stocks WHERE 1 LIMIT 500"
                             KeyDown="TxtSql_KeyDown"/>
                    <Button Grid.Column="1" Content="▶ 실행" Margin="6,0,0,0"
                            Background="#89B4FA" Foreground="#1E1E2E"
                            FontWeight="Bold" FontSize="11" Height="32"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnRun_Click"/>
                </Grid>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="MainGrid" Grid.Row="2"
                      Style="{StaticResource QuantDataGrid}"
                      Margin="0"/>

            <!-- 행 카운트 -->
            <Border Grid.Row="3" Background="#252536" Padding="10,0">
                <TextBlock x:Name="TxtRowCount" Text=""
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#6C7086" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
