<UserControl x:Class="Quant.UI.Views.EditWatchlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👁 WATCHLISTS" FontSize="11" FontWeight="Bold"
                               Foreground="#6C7086" VerticalAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,16,0"/>
                    <Button Content="＋ New"    Style="{StaticResource ActionBtn}" Click="BtnNew_Click"/>
                    <Button Content="✎ Edit"   Style="{StaticResource ActionBtn}" Click="BtnEdit_Click"/>
                    <Button Content="✕ Delete" Style="{StaticResource ActionBtn}"
                            Click="BtnDelete_Click" Foreground="#F38BA8"/>
                </StackPanel>
                <TextBlock x:Name="TxtRowCount" HorizontalAlignment="Right"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#6C7086" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <DataGrid x:Name="Grid" Grid.Row="1" Style="{StaticResource QuantDataGrid}"/>

        <Border Grid.Row="2" Background="#252536" Padding="10,0">
            <TextBlock x:Name="TxtStatus" Text=""
                       FontSize="10" FontFamily="Consolas"
                       Foreground="#6C7086" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
