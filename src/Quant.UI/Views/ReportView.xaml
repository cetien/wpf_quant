<UserControl x:Class="Quant.UI.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Quant.UI.Common"
             Background="#1E1E2E">
    <UserControl.Resources>
        <local:DbNullDoubleConverter x:Key="DbNullDoubleConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- 헤더 툴바 -->
        <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="📄 REPORTS" FontSize="11" FontWeight="Bold"
                               Foreground="#6C7086" VerticalAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,16,0"/>
                    <Button x:Name="BtnRefresh" Content="↺" Width="24" Height="20" Margin="2,0,6,0"
                            Background="#585B70" Foreground="#CDD6F4"
                            BorderThickness="0" FontWeight="Bold" FontSize="13"
                            Cursor="Hand" Click="BtnRefresh_Click"
                            ToolTip="DB에서 다시 읽기"/>
                    <Button x:Name="BtnIngest" Content="수집" Width="auto" Height="20" Margin="2,0,6,0"
                            Background="#89DCEB" Foreground="#1E1E2E"
                            BorderThickness="0" FontWeight="Bold" FontSize="11"
                            Cursor="Hand" Click="BtnIngest_Click"
                            ToolTip="spool 폴더 PDF 수집 후 목표주가 자동 추출"/>
                    <Button x:Name="BtnSkipTP" Content="TP" Width="auto" Height="20" Margin="2,0,10,0"
                            Background="#A6E3A1" Foreground="#1E1E2E"
                            BorderThickness="0" FontWeight="Bold" FontSize="11"
                            Cursor="Hand" Click="BtnSkipTP_Click"
                            ToolTip="목표주가 추출작업 완료 → 나머지는 SKIP"/>
                    <Button Click="ButtonShowAll_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand">
                        <TextBlock Text="Show All" FontSize="10"
                               Foreground="#FFCAD0A6" VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                    </Button>  
                    <Slider x:Name="SliderFrom"
                            Width="120"
                            Minimum="0"
                            Maximum="100"
                            Margin="12,0,6,0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSliderFrom"
                               Text="0"
                               FontSize="10"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                    <Slider x:Name="SliderTo"
                            Width="120"
                            Minimum="0"
                            Maximum="100"
                            Margin="12,0,6,0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSliderTo"
                               Text="0"
                               FontSize="10"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>

        
        <!-- 데이터 그리드 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="124"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="GridCompany" Grid.Column="0"
                      Style="{StaticResource QuantDataGrid}"
                      local:PopupMenuProps.TextColumn="name"
                      local:PopupMenuProps.IdColumn="id"
                      local:PopupMenuProps.MenuCategory="Ticker,Db"
                      AutoGeneratingColumn="OnGridAutoGeneratingColumn"
                      SelectionChanged="Grid_CompanyClick"
                      MouseRightButtonUp="OnGridRightClick"/>
            <DataGrid x:Name="GridDate" Grid.Column="1"
                      Style="{StaticResource QuantDataGrid}"
                      local:PopupMenuProps.TextColumn="date"
                      local:PopupMenuProps.IdColumn="date"
                      local:PopupMenuProps.MenuCategory="Report"
                      AutoGeneratingColumn="OnGridAutoGeneratingColumn"
                      MouseRightButtonUp="OnGridRightClick"
                      SelectionChanged="Grid_DateClick"/>
            <DataGrid x:Name="GridReport" Grid.Column="2"
                      Style="{StaticResource QuantDataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="False"
                      local:PopupMenuProps.TextColumn="name"
                      local:PopupMenuProps.IdColumn="ticker"
                      local:PopupMenuProps.MenuCategory="Ticker,Report,Db"
                      SelectionChanged="Grid_ReportClick"
                      MouseRightButtonUp="OnGridRightClick"
                      MouseDoubleClick="Grid_ReportDoubleClick"
                      CellEditEnding="GridReport_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="date"       Binding="{Binding date, StringFormat=\{0:yyyy-MM-dd\}}"       Width="70"  IsReadOnly="True"/>
                    <!-- <DataGridTextColumn Header="ticker"       Binding="{Binding ticker}"      Width="50"  IsReadOnly="True"/> -->
                    <DataGridTextColumn Header="group"      Binding="{Binding group}"       Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="name"       Binding="{Binding name}"  Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="upside"     Binding="{Binding upside, Converter={StaticResource DbNullDoubleConverter}, ConverterParameter=F1}" Width="50" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="TP" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding target_price, Converter={StaticResource DbNullDoubleConverter}, ConverterParameter=N0}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding target_price, UpdateSourceTrigger=Explicit}"
                                         Background="#313244" Foreground="#CDD6F4"
                                         BorderThickness="0" VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Right" GotFocus="TextBox_GotFocus"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="price"     Binding="{Binding price, StringFormat={}{0:N0}}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="title"  Binding="{Binding title}"  Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="writer" Binding="{Binding writer}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="st"     Binding="{Binding analyze_status}" Width="46" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
