<UserControl x:Class="Quant.UI.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- 헤더 툴바 -->
        <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄 REPORTS" FontSize="11" FontWeight="Bold"
                               Foreground="#6C7086" VerticalAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,16,0"/>
                    <Button Click="ButtonShowAll_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand">
                        <TextBlock Text="Show All" FontSize="10"
                               Foreground="#FFCAD0A6" VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                    </Button>  
                    <Slider x:Name="SliderFrom"
                            Width="120"
                            Minimum="0"
                            Maximum="100"
                            Margin="12,0,6,0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSliderFrom"
                               Text="0"
                               FontSize="10"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                    <Slider x:Name="SliderTo"
                            Width="120"
                            Minimum="0"
                            Maximum="100"
                            Margin="12,0,6,0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSliderTo"
                               Text="0"
                               FontSize="10"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                </StackPanel>
                <TextBlock x:Name="TxtRowCount" HorizontalAlignment="Right"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        
        <!-- 데이터 그리드 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="124"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="GridCompany" Grid.Column="0"
                      Style="{StaticResource QuantDataGrid}"
                      IsReadOnly="True"
                      SelectionChanged="Grid_CompanyClick"
                      MouseDoubleClick="Grid_CompanyDoubleClick"/>
            <DataGrid x:Name="GridDate" Grid.Column="1"
                      Style="{StaticResource QuantDataGrid}"
                      IsReadOnly="True"
                      SelectionChanged="Grid_DateClick"/>
            <DataGrid x:Name="GridReport" Grid.Column="2"
                      Style="{StaticResource QuantDataGrid}"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="Grid_ReportClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="date"   Binding="{Binding date}"   Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ticker" Binding="{Binding ticker}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="group"  Binding="{Binding group}"  Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="TP"     Binding="{Binding target_price, Converter={StaticResource FmtN0}}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="st"     Binding="{Binding analyze_status}" Width="46" IsReadOnly="True"/>
                    <DataGridTextColumn Header="title"  Binding="{Binding title}"  Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="writer" Binding="{Binding writer}" Width="100" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="" Width="36" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" FontSize="13"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="삭제"
                                        Foreground="#F38BA8"
                                        HorizontalAlignment="Center"
                                        Tag="{Binding}"
                                        Click="BtnDelete_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 상태바 -->
        <Border Grid.Row="2" Background="#252536" Padding="10,0">
            <TextBlock x:Name="TxtStatus" Text="" FontSize="10" FontFamily="Consolas" Foreground="#6C7086" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
