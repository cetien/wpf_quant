<!--  ChartView.xaml  -->
<UserControl x:Class="Quant.UI.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:lvc_core="clr-namespace:LiveChartsCore;assembly=LiveChartsCore"
             xmlns:ctrl="clr-namespace:Quant.UI.Controls"
             Background="#1E1E2E">

    <UserControl.Resources>
    </UserControl.Resources>

    <!-- ── 전체 레이아웃 Grid ──────────────────────────────── -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="300"/>
            <ColumnDefinition Width="4"/>   <!-- splitter -->
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Left side ═══════════════════════ -->
        <Grid Grid.Column="0" Cursor="">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>    <!-- 0: ticker -->
                <RowDefinition Height="32"/>    <!-- 1: Fundamentals -->
                <RowDefinition Height="Auto"/>  <!-- 2: Rating -->
                <RowDefinition Height="*" MinHeight="300"/>  <!-- 3: info -->
                <RowDefinition Height="4"/>     <!-- 4: splitter -->
                <RowDefinition Height="Auto" MinHeight="100"/>     <!-- 5: report -->
            </Grid.RowDefinitions>
            <!-- ══ Row 0: ticker ══════════════════════════════════ -->
            <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
                <Grid Margin="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStockName" Text="삼성전자" FontFamily="Consolas" Foreground="#F1DE10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtTickerCode" Width="80" Height="26"
                             Background="#313244" Foreground="#CDD6F4"
                             BorderBrush="#45475A" BorderThickness="1"
                             FontFamily="Consolas" FontSize="12" Padding="4,2"
                             VerticalContentAlignment="Center" Text="005930"
                             KeyDown="TxtTickerCode_KeyDown"/>
                        <Button Content="Load" Width="48" Height="26" Margin="4,0,16,0"
                            Background="#89B4FA" Foreground="#1E1E2E"
                            BorderThickness="0" FontWeight="Bold" FontSize="11"
                            Cursor="Hand" Click="BtnLoad_Click"/>
                        <Button Content="🔄" Width="30" Height="26" Style="{StaticResource IconBtn}"
                            Foreground="#8BF9BA" Click="BtnDownloadData_Click" ToolTip="가격 데이터 다운로드"/>
                        <Button Content="🔗" Width="30" Height="26" Style="{StaticResource IconBtn}"
                            Foreground="#8BF9BA" Click="BtnExternalLink_Click" ToolTip="네이버 금융"/>
                        <!-- 종목 제거 버튼 -->
                        <Button x:Name="BtnDeleteStock" Content="✗" Width="30" Height="26"
                            Style="{StaticResource IconBtn}"
                            Foreground="#F38BA8" 
                            Click="BtnDeleteStock_Click" ToolTip="종목 영구제거 (SPAC 등)"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- ══ Row 1: Fundamentals ════════════════════════════ -->
            <Border Grid.Row="1" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Fundamentals" FontSize="9" FontWeight="Bold" Foreground="#45475A" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ItemsControl ItemsSource="{Binding FundamentalMetrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource NormalText}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource BoldText}" Foreground="{Binding Color}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtFundDate" Foreground="#45475A" FontSize="9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- ══ Row 2: Rating ═══════════════════════ -->
            <Border Grid.Row="2" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1" Padding="10,6">
                <Grid VerticalAlignment="Center" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>       <!-- InfoPanel -->
                        <ColumnDefinition Width="200"/>     <!-- CartesianChart -->
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="Panel_StockInfo" Margin="2"/>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel>
                            <ctrl:RatingControl x:Name="RatingCtrl" Height="20" Margin="12,0,0,0"
                                            VerticalAlignment="Top"
                                            RatingChanged="RatingCtrl_RatingChanged" Foreground="#FFD200"/>
                            <Border Background="#1A1B29" BorderBrush="#313244" BorderThickness="1" CornerRadius="4">
                                <lvc:CartesianChart x:Name="MiniChart_ReturnRatio"
                                                    DrawMarginFrame="{x:Null}"
                                                    Background="#1E1E2E"
                                                    ZoomMode="None" Height="200" 
                                                    TooltipPosition="Hidden" RenderTransformOrigin="0.5,0.5"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <!-- ══ Row 3: info ═══════════════════════ -->
            <Border Grid.Row="3" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1" Padding="10,6">
                <TextBox x:Name="TxtStockInfo"
                         Text="-"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         MinHeight="44"
                         Padding="4"
                         FontFamily="Consolas"
                         FontSize="11"
                         Foreground="#FFF9F9C4"
                         Background="Transparent"
                         BorderThickness="0"/>
            </Border>
            <!-- splitter -->
            <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch"
                              Background="#FF878BAF" ResizeBehavior="PreviousAndNext"/>
            <!-- ══ Row 5: Report ═══════════════════════ -->
            <Border Grid.Row="5">
                <DataGrid x:Name="GridReport" Grid.Column="0" Style="{StaticResource QuantDataGrid}" AutoGenerateColumns="False"
                      SelectionChanged="GridReportClick" VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="date"   Binding="{Binding date}"   Width="90"/>
                        <DataGridTextColumn Header="title"  Binding="{Binding title}"  Width="300"/>
                        <DataGridTextColumn Header="writer" Binding="{Binding writer}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </Grid>

        <!-- splitter -->
        <GridSplitter Grid.Column="1" VerticalAlignment="Stretch"
                              Background="#FF878BAF" ResizeBehavior="PreviousAndNext" Cursor=""/>

        <!-- ══ Right side ═══════════════════════ -->
        <Grid x:Name="ChartGrid" Grid.Column="2"
              MouseMove="ChartGrid_MouseMove"
              MouseLeave="ChartGrid_MouseLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>   <!-- 0: 헤더 (티커/기간) -->
            <RowDefinition Height="32"/>   <!-- 1: 토글 툴바 -->
            <RowDefinition Height="Auto"/> <!-- 2: 수급·재무 패널 -->
            <RowDefinition Height="*"/>    <!-- 3: 메인 차트 -->
            <RowDefinition Height="0"/>    <!-- 4: 거래량 (토글) -->
            <RowDefinition Height="0"/>    <!-- 5: MACD (토글) -->
            <RowDefinition Height="0"/>    <!-- 6: RSI (토글) -->
            <RowDefinition Height="22"/>   <!-- 7: 상태바 -->
        </Grid.RowDefinitions>

        <!-- ══ Row 0: 헤더 ══════════════════════════════════ -->
        <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 기간 버튼 -->
                    <Button x:Name="Btn1M"  Content="1M" Click="BtnPeriod_Click" Tag="30"/>
                    <Button x:Name="Btn3M"  Content="3M" Click="BtnPeriod_Click" Tag="90"/>
                    <Button x:Name="Btn6M"  Content="6M" Click="BtnPeriod_Click" Tag="180"/>
                    <Button x:Name="Btn1Y"  Content="1Y"  Click="BtnPeriod_Click" Tag="365"/>
                    <Button x:Name="Btn2Y"  Content="2Y"  Click="BtnPeriod_Click" Tag="730"/>
                    <Button x:Name="BtnAll" Content="ALL" Click="BtnPeriod_Click" Tag="0"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="TxtChartPriceInfo" FontSize="10" FontFamily="Consolas" Text="price"
                               Foreground="#FFD5D5EF" VerticalAlignment="Center" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtChartDataLoadingInfo" FontSize="10" FontFamily="Consolas" Text="loading..."
                               Foreground="#FF5B5B7B" VerticalAlignment="Center" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Row 1: 토글 툴바 ════════════════════════════ -->
        <Border Grid.Row="1" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">

                <!-- 차트 타입 -->
                <Button x:Name="BtnChartType" Content="선" Style="{StaticResource ActionBtn}"
                        Click="BtnChartType_Click" ToolTip="선/봉 전환"/>
                <!-- 로그 스케일 -->
                    <!-- <Button x:Name="BtnLog" Content="Log" Style="{StaticResource ActionBtn}" Click="BtnLog_Click" ToolTip="로그 스케일"/> -->

                <Rectangle Fill="#313244" Width="1" Margin="6,4"/>

                <!-- MA 토글 -->
                <TextBlock Text="MA" FontFamily="Consolas" FontSize="10"
                           Foreground="#45475A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Content="5"   Tag="5"   Style="{StaticResource ActionBtn}" Click="BtnMa_Click"
                        Foreground="#F9E2AF" ToolTip="MA5 (노랑)"/>
                <Button Content="20"  Tag="20"  Style="{StaticResource ActionBtn}" Click="BtnMa_Click"
                        Foreground="#A6E3A1" ToolTip="MA20 (초록)"/>
                <Button Content="60"  Tag="60"  Style="{StaticResource ActionBtn}" Click="BtnMa_Click"
                        Foreground="#FAB387" ToolTip="MA60 (주황)"/>
                <Button Content="120" Tag="120" Style="{StaticResource ActionBtn}" Click="BtnMa_Click"
                        Foreground="#CBA6F7" ToolTip="MA120 (보라)"/>

                <Rectangle Fill="#313244" Width="1" Margin="6,4"/>

                <!-- 보조지표 -->
                <Button x:Name="BtnVol"  Content="VOL"  Style="{StaticResource ActionBtn}"
                        Click="BtnVol_Click"  ToolTip="거래량"/>
                <Button x:Name="BtnMacd" Content="MACD" Style="{StaticResource ActionBtn}"
                        Click="BtnMacd_Click" ToolTip="MACD (12/26/9)"/>
                <Button x:Name="BtnRsi"  Content="RSI"  Style="{StaticResource ActionBtn}"
                        Click="BtnRsi_Click"  ToolTip="RSI (14)"/>

            </StackPanel>
        </Border>

        <!-- ══ Row 2: 수급·재무 패널 ═══════════════════════ -->
        <Border Grid.Row="2" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="SUPPLY" FontSize="9" FontWeight="Bold" Foreground="#45475A"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <ItemsControl ItemsSource="{Binding SupplyMetrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource NormalText}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource BoldText}" Foreground="{Binding Color}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtSupplyDate" Foreground="#45475A" FontSize="9" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Row 3: 메인 차트 ════════════════════════════ -->
        <lvc:CartesianChart x:Name="MainChart"
                            Grid.Row="3"
                            Background="#1E1E2E"
                            Series="{Binding Series}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            ZoomMode="X"
                            TooltipPosition="Hidden"/>

        <!-- ══ Row 4: 거래량 서브차트 (높이=0 → 토글로 제어) -->
        <Grid Grid.Row="4" Background="#1A1A2E">
            <TextBlock Text="VOL" Style="{StaticResource SmallText}"/>
            <lvc:CartesianChart x:Name="VolChart"
                                Margin="0,16,0,0"
                                Background="Transparent"
                                Series="{Binding VolSeries}"
                                XAxes="{Binding VolXAxes}"
                                YAxes="{Binding VolYAxes}"
                                ZoomMode="X"
                                TooltipPosition="Hidden"
                                LegendPosition="Hidden"/>
        </Grid>

        <!-- ══ Row 5: MACD 서브차트 ════════════════════════ -->
        <Grid Grid.Row="5" Background="#1A1A2E">
            <TextBlock Text="MACD(12,26,9)" Style="{StaticResource SmallText}"/>
            <lvc:CartesianChart x:Name="MacdChart"
                                Margin="0,16,0,0"
                                Background="Transparent"
                                Series="{Binding MacdSeries}"
                                XAxes="{Binding MacdXAxes}"
                                YAxes="{Binding MacdYAxes}"
                                ZoomMode="X"
                                TooltipPosition="Hidden"
                                LegendPosition="Hidden"/>
        </Grid>

        <!-- ══ Row 6: RSI 서브차트 ═════════════════════════ -->
        <Grid Grid.Row="6" Background="#1A1A2E">
            <TextBlock Text="RSI(14)" Style="{StaticResource SmallText}"/>
            <lvc:CartesianChart x:Name="RsiChart"
                                Margin="0,16,0,0"
                                Background="Transparent"
                                Series="{Binding RsiSeries}"
                                XAxes="{Binding RsiXAxes}"
                                YAxes="{Binding RsiYAxes}"
                                ZoomMode="X"
                                TooltipPosition="Hidden"
                                LegendPosition="Hidden"/>
        </Grid>

        <!-- ══ Row 7: 상태바 ════════════════════════════════ -->
        <Border Grid.Row="7" Background="#252536" Padding="10,0">
            <TextBlock x:Name="TxtStatus" Text=""
                       FontSize="10" FontFamily="Consolas"
                       Foreground="#6C7086" VerticalAlignment="Center"/>
        </Border>

        <!-- ══ Crosshair 오버레이 ══════════════════════════
             Row 3~6(차트 영역 전체)를 덮는 투명 Canvas.
             IsHitTestVisible=False → 차트 ZoomMode/Tooltip 이벤트 통과.
             MouseMove는 ChartGrid에서 수신 → Canvas 좌표로 변환하여 Line 이동.
        ═══════════════════════════════════════════════════ -->
        <Canvas x:Name="CrosshairCanvas"
                Grid.Row="3" Grid.RowSpan="4"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <!-- 세로선 (X축 방향) -->
            <Line x:Name="CrossV"
                  Stroke="#4C566A" StrokeThickness="1"
                  StrokeDashArray="4,3"
                  X1="0" Y1="0" X2="0" Y2="0"/>
            <!-- 가로선 (Y축 방향) -->
            <Line x:Name="CrossH"
                  Stroke="#4C566A" StrokeThickness="1"
                  StrokeDashArray="4,3"
                  X1="0" Y1="0" X2="0" Y2="0"/>
        </Canvas>

        <!-- ── 툴팁 패널 (Canvas와 분리 — MouseLeave 시에도 유지 가능) ── -->
        <Border x:Name="TooltipPanel"
                Grid.Row="3" Grid.RowSpan="4"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8,8,0,0"
                Background="#CC1E1E2E"
                BorderBrush="#45475A" BorderThickness="1"
                CornerRadius="4" Padding="8,6"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel>
                <!-- 날짜 -->
                <TextBlock x:Name="TtDate"
                           FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                           Foreground="#CDD6F4" Margin="0,0,0,4"/>
                <!-- Price 섹션 -->
                <TextBlock x:Name="TtPrice"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="#89B4FA"/>
                <!-- MA 섹션 -->
                <TextBlock x:Name="TtMa"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="#6C7086" Margin="0,2,0,0"/>
                <!-- VOL / 수급 섹션 -->
                <TextBlock x:Name="TtVol"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="#6C7086" Margin="0,4,0,0"/>
                <!-- MACD 섹션 -->
                <TextBlock x:Name="TtMacd"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="#6C7086" Margin="0,2,0,0"/>
                <!-- RSI 섹션 -->
                <TextBlock x:Name="TtRsi"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="#CBA6F7" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

    </Grid>

    <!-- ══ 신규종목 등록 Popup ════════════════════════════════
         종목이 stocks테이블에 없을 때 Load 후 표시.
         실제 Popup은 Left Panel 없는 Right side(ChartGrid)와 격리될 수 있어
         전체 Grid를 덮는 Adorner로 구현.
    ═══════════════════════════════════════════════════════ -->
    <Grid x:Name="RegisterOverlay"
          Visibility="Collapsed"
          Background="#AA000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#252536" BorderBrush="#45475A" BorderThickness="1"
                CornerRadius="6" Padding="24,20" MinWidth="360">
            <StackPanel>
                <!-- 제목 -->
                <TextBlock Text="신규 종목 등록"
                           FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                           Foreground="#CDD6F4" Margin="0,0,0,14"/>

                <!-- ticker + 조회된 정보 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ticker" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRegTicker" Grid.Column="1"
                               FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                               Foreground="#89B4FA" VerticalAlignment="Center"/>
                </Grid>

                <!-- 종목명 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="종목명" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRegName" Grid.Column="1"
                             Height="26" Padding="6,2"
                             Background="#313244" Foreground="#CDD6F4"
                             BorderBrush="#45475A" BorderThickness="1"
                             FontFamily="Consolas" FontSize="11"
                             VerticalContentAlignment="Center"
                             ToolTip="Yahoo에서 자동 조회. 실패 시 직접 입력."/>
                </Grid>

                <!-- Market -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Market" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbRegMarket" Grid.Column="1"
                              Height="26"
                              Background="#313244">
                        <ComboBoxItem Content="KP" IsSelected="True"/>
                        <ComboBoxItem Content="KQ"/>
                        <ComboBoxItem Content="NYSE"/>
                        <ComboBoxItem Content="NASDAQ"/>
                        <ComboBoxItem Content="ETC"/>
                    </ComboBox>
                </Grid>

                <!-- 유형 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="유형" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbRegType" Grid.Column="1"
                              Height="26"
                              Background="#313244">
                        <ComboBoxItem Content="stock" IsSelected="True"/>
                        <ComboBoxItem Content="ETF"/>
                        <ComboBoxItem Content="index"/>
                    </ComboBox>
                </Grid>

                <!-- Yahoo 조회 상태 메시지 -->
                <TextBlock x:Name="TxtRegMsg"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="#6C7086"
                           Margin="0,4,0,12" TextWrapping="Wrap"
                           Text="Yahoo에서 자동 조회 중..."/>

                <!-- 버튼 행 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Width="64" Height="28" Margin="0,0,8,0"
                            Style="{StaticResource ActionBtn}"
                            Click="BtnRegCancel_Click"/>
                    <Button x:Name="BtnRegSave" Content="등록" Width="64" Height="28"
                            Background="#89B4FA" Foreground="#1E1E2E"
                            BorderThickness="0" FontWeight="Bold" FontSize="11"
                            Cursor="Hand"
                            Click="BtnRegSave_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</Grid>

</UserControl>
