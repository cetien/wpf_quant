<UserControl x:Class="Quant.UI.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <!-- 좌측 여백 -->
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="4"/>
            <!-- 좌측 여백 -->
            <ColumnDefinition Width="*"/>            <!-- 좌측 여백 -->
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <DataGrid x:Name="GridFilter" Style="{StaticResource QuantDataGrid}" VerticalAlignment="Top" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="on" Width="30" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding filter_activated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="FilterActivated_Changed"
                                                  Unchecked="FilterActivated_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="name"  Binding="{Binding kind}"         Width="*"/>
                    <DataGridTextColumn Header="desc"     Binding="{Binding description}"       Width="60"/>
                    <DataGridTextColumn Header="sql"     Binding="{Binding sql}"       Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Column="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="Panel_Info" Margin="2"/>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 검색 입력 영역 -->
                <RowDefinition Height="Auto"/>  <!-- 필터 바 -->
                <RowDefinition Height="*"/>     <!-- 결과 그리드 -->
                <RowDefinition Height="Auto"/>  <!-- 상태 바 -->
            </Grid.RowDefinitions>

            <!-- ── 검색 입력 영역 ── -->
            <Border Grid.Row="0" Background="#181825" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtQuery"
                             Grid.Column="0"
                             FontFamily="Consolas" FontSize="14"
                             Foreground="#CDD6F4" Background="#313244"
                             BorderBrush="#45475A" BorderThickness="1"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             KeyDown="TxtQuery_KeyDown"/>
                    <Button x:Name="BtnSearch"
                            Grid.Column="1"
                            Content="검색" Margin="8,0,0,0"
                            Padding="16,6"
                            FontFamily="Consolas"
                            Click="BtnSearch_Click"/>
                    <Button x:Name="BtnClear"
                            Grid.Column="2"
                            Content="초기화" Margin="4,0,0,0"
                            Padding="12,6"
                            FontFamily="Consolas"
                            Click="BtnClear_Click"/>
                </Grid>
            </Border>

            <!-- ── 필터 바 ── -->
            <Border Grid.Row="1" Background="#1E1E2E" Padding="12,6" BorderBrush="#313244" BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal">
                    <!-- Market 필터 -->
                    <TextBlock Text="Market:" Foreground="#6C7086" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbMarket" Width="90" FontFamily="Consolas" FontSize="12"
                              Margin="0,0,16,0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="전체" IsSelected="True"/>
                        <ComboBoxItem Content="KP"/>
                        <ComboBoxItem Content="KQ"/>
                        <ComboBoxItem Content="NYSE"/>
                    </ComboBox>

                    <!-- SecurityType 필터 -->
                    <TextBlock Text="Type:" Foreground="#6C7086" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbType" Width="90" FontFamily="Consolas" FontSize="12"
                              Margin="0,0,16,0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="전체" IsSelected="True"/>
                        <ComboBoxItem Content="stock"/>
                        <ComboBoxItem Content="ETF"/>
                        <ComboBoxItem Content="index"/>
                    </ComboBox>

                    <!-- Rating 필터 -->
                    <TextBlock Text="Rating≥:" Foreground="#6C7086" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbRating" Width="60" FontFamily="Consolas" FontSize="12"
                              Margin="0,0,16,0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="전체" IsSelected="True"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                    </ComboBox>

                    <!-- 결과 카운트 -->
                    <TextBlock x:Name="TxtResultCount" Text="" Foreground="#89B4FA"
                               FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
            </Border>

            <!-- ── 결과 DataGrid ── -->
            <DataGrid x:Name="GridResults"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                     
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="#1E1E2E"
                      Foreground="#CDD6F4"
                      FontFamily="Consolas" FontSize="12"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#313244"
                      BorderThickness="0"
                      RowBackground="#1E1E2E"
                      AlternatingRowBackground="#181825"
                      MouseDoubleClick="GridResults_MouseDoubleClick"
                      SelectionChanged="GridResults_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="name"   Binding="{Binding name}"   Width="*"/>
                    <DataGridTextColumn Header="mkt" Binding="{Binding market}" Width="25"/>
                    <DataGridTextColumn Header="★" Binding="{Binding rating}" Width="25"/>
                    <DataGridTextColumn Header="1M %"              Binding="{Binding ret_1m,             Converter={StaticResource FmtF2}, ConverterParameter=F2}" Width="48"/>
                    <DataGridTextColumn Header="3M %"              Binding="{Binding ret_3m,             Converter={StaticResource FmtF2}, ConverterParameter=F2}" Width="48"/>
                    <DataGridTextColumn Header="6M %"              Binding="{Binding ret_6m,             Converter={StaticResource FmtF2}, ConverterParameter=F2}" Width="48"/>
                    <DataGridTextColumn Header="1Y %"              Binding="{Binding ret_1y,             Converter={StaticResource FmtF2}, ConverterParameter=F2}" Width="48"/>
                    <DataGridTextColumn Header="rs"                Binding="{Binding rs,                 Converter={StaticResource FmtF1}, ConverterParameter=F1}" Width="40"/>
                    <DataGridTextColumn Header="%atr"              Binding="{Binding atr_percent,        Converter={StaticResource FmtF1}, ConverterParameter=F1}" Width="40"/>
                    <DataGridTextColumn Header="high"  Binding="{Binding distance_from_high, Converter={StaticResource FmtF1}, ConverterParameter=F1}" Width="40"/>
                    <DataGridTextColumn Header="per"               Binding="{Binding per,                Converter={StaticResource FmtN0}, ConverterParameter=N0}" Width="30"/>
                    <DataGridTextColumn Header="pbr"               Binding="{Binding pbr,                Converter={StaticResource FmtN0}, ConverterParameter=F2}" Width="30"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── 상태 바 ── -->
            <Border Grid.Row="3" Background="#181825" Padding="12,4">
                <TextBlock x:Name="TxtStatus"
                           Text="종목명 또는 Ticker를 입력하고 Enter 또는 검색 버튼을 누르세요."
                           Foreground="#6C7086" FontFamily="Consolas" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
