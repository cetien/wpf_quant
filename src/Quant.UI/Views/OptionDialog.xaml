<Window x:Class="Quant.UI.Views.OptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="#CDD6F4">

    <Window.Resources>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Checkboxes ── -->
        <StackPanel Grid.Row="0">
            <CheckBox x:Name="ChkAutoAppend" Content="Auto append to history"
                      Foreground="#CDD6F4" FontFamily="Consolas" FontSize="12"/>
            <CheckBox x:Name="ChkQueryFilterPreferred" Content="QueryFilter: Preferred/Spec"
                      Foreground="#CDD6F4" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0"/>
            <CheckBox x:Name="ChkQueryFilterCovered" Content="QueryFilter: Leverage/Covered"
                      Foreground="#CDD6F4" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0"/>
            <CheckBox x:Name="ChkQueryFilterCheap" Content="QueryFilter: Price &lt; 1000"
                      Foreground="#CDD6F4" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0"/>
            <Separator Background="#313244" Margin="0,10,0,6"/>
            <TextBlock Text="Global Stock Filter" Foreground="#6C7086"
                       FontFamily="Consolas" FontSize="10" Margin="0,0,0,4"/>
            <CheckBox x:Name="ChkExcludeSpac" Content="스팩(SPAC) 종목 제외  (name LIKE '%스팩%')"
                      Foreground="#CDD6F4" FontFamily="Consolas" FontSize="12"/>
            <CheckBox x:Name="ChkExcludePrefStock" Content="우선주 제외  (ticker 끝자리 &#x2260; 0)"
                      Foreground="#CDD6F4" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0"/>
            <CheckBox x:Name="ChkExcludeHalted" Content="거래정지 제외  (stock_cache.current_price = 0)"
                      Foreground="#CDD6F4" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
        <!-- ── Report PDF Folder ── -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Report PDF folder"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox  Grid.Column="0" x:Name="TxtPdfFolder"
                          ToolTip="PDF 리포트를 감시할 폴더"/>
                <Button   Grid.Column="2" x:Name="BtnBrowse" Content="Browse…"
                          Click="BtnBrowse_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DB: "/>
                <TextBox Grid.Column="2"  x:Name="DB_Folder" IsReadOnly="True"/>
            </Grid>
        </StackPanel>

        <!-- ── OK / Cancel ── -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" 
                    Width="72" Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
            <Button Content="OK" 
                    Width="72"
                    Background="#89B4FA" Foreground="#1E1E2E" FontWeight="Bold"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
