<!-- TargetPriceView.xaml -->
<UserControl x:Class="Quant.UI.Views.TargetPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#1E1E2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>   <!-- 0: 툴바 (토글 탭 + 종목 검색) -->
            <RowDefinition Height="Auto"/> <!-- 1: 상단 패널 (target_price_stocks) -->
            <RowDefinition Height="*"/>    <!-- 2: Chart / Grid -->
        </Grid.RowDefinitions>

        <!-- ══ Row 0: 툴바 ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Chart / Grid 토글 버튼 -->
                    <Button x:Name="BtnToggleChart" Content="📊 Chart"
                            Style="{StaticResource ActionBtn}"
                            Width="76" Height="28"
                            Click="BtnToggleChart_Click"
                            ToolTip="월별 목표주가 차트"/>
                    <Button x:Name="BtnToggleGrid"  Content="📋 Grid"
                            Style="{StaticResource ActionBtn}"
                            Width="76" Height="28" Margin="0,0,16,0"
                            Click="BtnToggleGrid_Click"
                            ToolTip="월별 목표주가 표"/>

                    <!-- 종목 검색 (ChartView TxtStockSearch 방식) -->
                    <Grid>
                        <TextBox x:Name="TxtStockSearch" Width="140" Height="28"
                                 Background="#313244" Foreground="#CDD6F4"
                                 BorderBrush="#45475A" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="11" Padding="6,2"
                                 VerticalContentAlignment="Center"
                                 ToolTip="종목 검색 (티커 또는 종목명)"
                                 TextChanged="TxtStockSearch_TextChanged"
                                 PreviewKeyDown="TxtStockSearch_PreviewKeyDown"
                                 GotFocus="TextBox_GotFocus"/>

                        <Popup x:Name="PopupSearch"
                               PlacementTarget="{Binding ElementName=TxtStockSearch}"
                               Placement="Bottom"
                               StaysOpen="False">
                            <Border BorderBrush="#45475A" BorderThickness="1" Background="#252536">
                                <ListBox x:Name="ListSearchResult"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#CDD6F4"
                                         MaxHeight="240"
                                         PreviewMouseLeftButtonUp="ListSearchResult_PreviewMouseLeftButtonUp"
                                         KeyDown="ListSearchResult_KeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Ticker}" Foreground="#89B4FA"
                                                           FontWeight="SemiBold" FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 새로고침 버튼 -->
                    <Button Content="🔄" Width="30" Height="28" Margin="4,0,0,0"
                            Style="{StaticResource IconBtn}" Foreground="#8BF9BA"
                            Click="BtnRefresh_Click" ToolTip="데이터 새로고침"/>

                </StackPanel>

                <!-- 우측: 상태 텍스트 -->
                <TextBlock x:Name="TxtStatus" HorizontalAlignment="Right"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#6C7086" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ Row 1: 상단 패널 (target_price_stocks 최신 row) ══════ -->
        <Border Grid.Row="1" Background="#252536" BorderBrush="#45475A" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 레이블 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="TARGET PRICE" FontSize="9" FontWeight="Bold"
                               Foreground="#45475A" FontFamily="Consolas"/>
                </StackPanel>

                <!-- 종목 info chips -->
                <WrapPanel x:Name="PanelStockInfo" Grid.Column="1"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- ══ Row 2: Chart / Grid (토글) ═══════════════════════════ -->
        <Grid Grid.Row="2">

            <!-- Chart 패널 -->
            <Grid x:Name="PanelChart" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>    <!-- 메인 차트 -->
                    <RowDefinition Height="*" MinHeight="60" MaxHeight="160"/>  <!-- upside 서브차트 -->
                </Grid.RowDefinitions>

                <!-- 메인 차트: avg_tgt + price -->
                <Border Grid.Row="0" Background="#1A1B29" BorderBrush="#313244" BorderThickness="0,0,0,1">
                    <lvc:CartesianChart x:Name="MainChart"
                                        Background="#1E1E2E"
                                        Series="{Binding TpSeries}"
                                        XAxes="{Binding TpXAxes}"
                                        YAxes="{Binding TpYAxes}"
                                        ZoomMode="X"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Top"/>
                </Border>

                <!-- 서브 차트: upside % -->
                <Grid Grid.Row="1" Background="#1A1A2E">
                    <TextBlock Text="Upside %" Style="{StaticResource SmallText}"/>
                    <lvc:CartesianChart x:Name="UpsideChart"
                                        Margin="0,16,0,0"
                                        Background="Transparent"
                                        Series="{Binding UpsideSeries}"
                                        XAxes="{Binding UpsideXAxes}"
                                        YAxes="{Binding UpsideYAxes}"
                                        ZoomMode="X"
                                        AnimationsSpeed="0"
                                        TooltipPosition="Top"
                                        LegendPosition="Hidden"/>
                </Grid>
            </Grid>

            <!-- Grid 패널 -->
            <DataGrid x:Name="GridMonthly" Visibility="Collapsed"
                      Style="{StaticResource QuantDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      VerticalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="YM"           Binding="{Binding Ym}"            Width="60"/>
                    <DataGridTextColumn Header="Reports"      Binding="{Binding ReportCount}"   Width="60"/>
                    <DataGridTextColumn Header="Avg TP"       Binding="{Binding AvgTgt, StringFormat={}{0:N0}}"   Width="80"/>
                    <DataGridTextColumn Header="Min TP"       Binding="{Binding MinTgt, StringFormat={}{0:N0}}"   Width="80"/>
                    <DataGridTextColumn Header="Max TP"       Binding="{Binding MaxTgt, StringFormat={}{0:N0}}"   Width="80"/>
                    <DataGridTextColumn Header="Price"        Binding="{Binding Price, StringFormat={}{0:N0}}"     Width="80"/>
                    <DataGridTextColumn Header="Upside %"     Binding="{Binding Upside, StringFormat={}{0:P1}}"    Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

    </Grid>
</UserControl>
